---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OrderDialog from '../components/OrderDialog.astro';
import MenuCard from '../components/MenuCard.astro';
import { menu, addons, branches, WA_DISPLAY, waLink, FOUNDED } from '../data/site';

import logo from '../assets/images/logo-mbak-rina-hd.png';
import heroBesek from '../assets/images/hero-paket-besek.jpg';
import thumbKlaten from '../assets/images/hero-thumb-ayam-bakar-klaten.jpg';
import thumbUtuh from '../assets/images/hero-thumb-ayam-utuh.jpg';
import nasiboxBesek from '../assets/images/nasibox-besek.jpg';
import nasiboxMika from '../assets/images/nasibox-mika.jpg';

const title = 'Ayam Mbak Rina – Ayam & Bebek Bumbu Kuning, Nasi Box Semarang';
const description =
  'Ayam bumbu kuning, rempah laos, bumbu Klaten, dan bebek bumbu kuning khas Semarang sejak 2021. Nasi box mulai Rp30.000. Lapak di Pasar Gang Baru & Pasar Prembaen. Pesan via WhatsApp.';

const features = [
  { icon: 'calendar', bg: 'bg-[#E3F5E8] text-green-dark', title: `Sejak ${FOUNDED}`, note: 'Dua cabang pasar' },
  { icon: 'leaf', bg: 'bg-[#FFF3D1] text-gold', title: 'Rempah Alami', note: 'Tanpa Pengawet' },
  { icon: 'restaurant', bg: 'bg-red-soft text-red', title: 'Porsi Lengkap', note: 'Potong, Utuh, Box' },
  { icon: 'fire', bg: 'bg-red-soft text-red', title: 'Free Sambal', note: 'Bawang & Terasi' },
] as const;

const reasons = [
  {
    icon: 'fire',
    bg: 'bg-[#FFDAD6] text-red',
    title: 'Ungkep Bumbu Meresap',
    text: 'Dimasak dengan api kecil selama berjam-jam agar bumbu rempah kuning kunyit meresap hingga ke serat tulang terdalam.',
  },
  {
    icon: 'grain',
    bg: 'bg-[#FFDFA0] text-gold',
    title: 'Serundeng Laos Melimpah',
    text: 'Kremesan lengkuas asli berlimpah yang diparut halus dan digoreng garing keemasan, menghadirkan sensasi kriuk gurih tiada tanding.',
  },
  {
    icon: 'restaurant',
    bg: 'bg-green-soft text-green-dark',
    title: 'Daging Empuk Bebas Bau',
    text: 'Teknik pengolahan bebek dan ayam khusus Mbak Rina menjamin daging empuk tanpa aroma prengus sedikitpun.',
  },
  {
    icon: 'box',
    bg: 'bg-[#FEC330] text-[#5B4300]',
    title: 'Spesialis Nasi Box Acara',
    text: 'Menerima pesanan nasi box dan besek untuk acara kantor, arisan, syukuran, hingga pernikahan.',
  },
] as const;

const stats = [
  { value: FOUNDED, label: 'Berjualan sejak', color: 'text-red', valueFirst: false },
  { value: '2', label: 'Cabang di Pasar Semarang', color: 'text-[#795900]', valueFirst: true },
  { value: '3200+', label: 'Orderan Sukses', color: 'text-green-dark', valueFirst: true },
];

const navLinks = [
  { href: '#menu', label: 'Menu' },
  { href: '#nasi-box', label: 'Nasi Box' },
  { href: '#lokasi', label: 'Lokasi' },
];
const perks = ['Gratis sambal bawang / terasi', 'Harga bisa menyesuaikan pesanan', 'Ayam & bebek, dimasak tiap hari'];
const firstMenu = menu.slice(0, 4);
const restMenu = menu.slice(4);
---

<Base title={title} description={description}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">Lewati ke konten</a>

  <!-- Nav -->
  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur-sm">
    <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-2 lg:px-0 lg:py-3" aria-label="Utama">
      <a href="/" aria-label="Ayam Mbak Rina, ke beranda">
        <Image src={logo} alt="Logo Ayam Mbak Rina" width={125} height={110} densities={[1, 2, 3]} class="h-16 w-auto lg:h-[88px]" loading="eager" />
      </a>
      <div class="hidden items-center gap-10 lg:flex">
        {navLinks.map((l) => <a href={l.href} class="font-medium text-[#2A1A12] hover:text-red">{l.label}</a>)}
        <button type="button" data-press data-order class="rounded-full bg-red px-6 py-3 font-bold text-white hover:bg-red-dark">Pesan via WA</button>
      </div>
      <button type="button" data-open="nav-dialog" class="grid size-11 place-items-center rounded-xl bg-white text-ink lg:hidden" aria-label="Buka menu navigasi">
        <Icon name="menu" class="size-6" />
      </button>
    </nav>
  </header>

  <dialog id="nav-dialog" class="m-0 mb-auto w-full max-w-none rounded-b-[20px] bg-cream p-5 pb-6 text-ink" aria-label="Navigasi">
    <div class="flex items-center justify-between">
      <span class="text-[13px] font-bold uppercase tracking-wide text-muted">Menu</span>
      <button type="button" data-close class="grid size-11 place-items-center rounded-xl bg-white" aria-label="Tutup menu navigasi"><Icon name="close" class="size-6" /></button>
    </div>
    <ul class="mt-2">
      {navLinks.map((l) => (
        <li><a href={l.href} data-close class="block py-3.5 text-lg font-bold">{l.label === 'Menu' ? 'Menu & Harga' : l.label}</a></li>
      ))}
    </ul>
    <button type="button" data-press data-order class="mt-3 w-full rounded-full bg-red py-3.5 font-bold text-white">Pesan via WA</button>
  </dialog>

  <main id="main">
    <!-- Hero -->
    <section class="mx-auto grid max-w-[1200px] gap-10 px-5 pb-14 pt-6 lg:grid-cols-[1fr_500px] lg:items-start lg:gap-12 lg:px-0 lg:pb-20 lg:pt-10">
      <div class="hero-in flex flex-col gap-7">
        <p class="hidden w-fit items-center gap-2 rounded-full bg-red-soft px-4 py-2 text-base font-semibold text-red-dark lg:inline-flex">
          <Icon name="restaurant" class="size-4" />Kuliner Tradisional Semarang · Sejak Tahun {FOUNDED}
        </p>
        <h1 class="hero-title font-display text-[36px] font-bold leading-[1.15] text-ink lg:text-[60px]">
          {['Nikmatnya', 'Olahan', 'Ayam', '&', 'Bebek'].map((w, i) => <><span class="word"><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}
          <span class="hero-mark text-red">{['Asli', 'Mbak', 'Rina'].map((w, i) => <><span class="word"><span style={`--i:${i + 5}`}>{w}</span></span>{i < 2 ? ' ' : ''}</>)}</span>
        </h1>
        <p class="text-base leading-relaxed text-[#5A4A42] lg:text-[19px]">
          Spesialis Ayam Bumbu Kuning, Rempah Laos Melimpah, Ayam Bumbu Klaten, &amp; Bebek Bumbu Kuning Empuk Gurih. Disajikan hangat lengkap dengan rempah ungkep meresap dan <strong class="text-ink">FREE sambal segar bebas pilih!</strong>
        </p>
        <ul class="grid grid-cols-2 gap-2.5">
          {features.map((f) => (
            <li class="flex items-center gap-2.5 rounded-2xl bg-white p-2.5 lg:gap-3 lg:p-3">
              <span class={`grid size-8 shrink-0 place-items-center rounded-full ${f.bg}`}><Icon name={f.icon} class="size-[18px]" /></span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold leading-tight text-ink lg:text-[15px]">{f.title}</span>
                <span class="block text-xs text-muted lg:text-[13px]">{f.note}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-3 sm:flex-row">
          <button type="button" data-press data-order class="flex items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-red px-6 py-4 text-[17px] font-bold text-white hover:bg-red-dark">
            <Icon name="cart" />Pesan Sekarang (WhatsApp)
          </button>
          <a href="#menu" class="flex items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-stone px-6 py-4 text-[17px] font-bold text-ink hover:bg-[#E0D9D4]">
            Lihat Daftar Menu &amp; Harga<Icon name="down" />
          </a>
        </div>
        <p class="hidden items-center gap-2.5 text-sm font-semibold text-[#4A3C35] lg:flex">
          <span class="hero-open size-3 rounded-full bg-[#34C759]" aria-hidden="true"></span>
          Buka Setiap Hari: Cabang Pasar Gang Baru No. 78 • Cabang Pasar Prembaen No. 1046
        </p>
      </div>

      <div class="hero-card relative rounded-[32px] bg-white p-3.5 shadow-[0_20px_50px_-30px_rgba(30,20,16,0.35)] lg:p-[22px]">
        <div class="hero-photo relative overflow-hidden rounded-3xl bg-[#EEE]">
          <Image src={heroBesek} alt="Paket nasi besek tradisional: ayam kremesan laos, timun, kemangi, dan sambal" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 456px, 92vw" class="h-[400px] w-full object-cover lg:h-[560px]" loading="eager" fetchpriority="high" />
          <div class="hero-info absolute inset-x-4 bottom-4 flex flex-col gap-2 rounded-[18px] bg-white/95 p-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-lg font-semibold leading-tight text-ink">Paket Nasi Besek Tradisional</p>
              <p class="mt-1 text-[13px] text-[#5A4A42]">Kremesan laos, timun, kemangi &amp; sambal</p>
            </div>
            <p class="flex items-baseline gap-2 lg:flex-col lg:items-end lg:gap-0">
              <span class="text-xs font-bold tracking-wide text-red">MULAI</span>
              <span class="whitespace-nowrap text-2xl font-bold text-red">Rp 30.000 <span class="text-base font-normal text-muted">/box</span></span>
            </p>
          </div>
        </div>
        <div class="hero-minis mt-3.5 grid gap-3 lg:grid-cols-2">
          {[
            { img: thumbKlaten, alt: 'Ayam bumbu Klaten', name: 'Ayam Bumbu Klaten', price: 'Rp 17.000', unit: '/potong' },
            { img: thumbUtuh, alt: 'Ayam utuh bumbu kuning', name: 'Ayam Utuh', price: 'Rp 75.000', unit: '/ekor' },
          ].map((m) => (
            <div class="flex items-center gap-3 rounded-[18px] bg-stone-2 p-3 transition-transform duration-300 lg:hover:-translate-y-0.5">
              <Image src={m.img} alt={m.alt} width={128} height={128} class="size-16 shrink-0 rounded-xl object-cover" loading="eager" />
              <div>
                <p class="text-[17px] font-semibold leading-tight text-ink">{m.name}</p>
                <p class="text-[15px] font-bold text-red">{m.price} <span class="text-xs font-normal text-muted">{m.unit}</span></p>
              </div>
            </div>
          ))}
        </div>
        <p class="hero-badge absolute -bottom-5 right-4 flex items-center gap-2 rounded-full bg-gold px-5 py-3 font-semibold text-[#FFF3D1] lg:-right-8">
          <Icon name="star" class="size-4" />Resep Otentik Semarang
        </p>
      </div>
    </section>

    <!-- Strip: static row on desktop, running text on mobile -->
    <div class="overflow-hidden bg-yellow text-[#2A1A12]">
      <ul class="mx-auto hidden max-w-[1200px] items-center justify-center gap-8 py-6 text-xl font-bold lg:flex">
        {perks.map((t, i) => <>{i > 0 && <li class="size-2 rounded-full bg-red" aria-hidden="true"></li>}<li>{t}</li></>)}
      </ul>
      <div class="marquee py-3.5 text-[15px] font-bold lg:hidden">
        <ul class="sr-only">{perks.map((t) => <li>{t}</li>)}</ul>
        <div class="marquee-track" aria-hidden="true">
          {[0, 1].map(() => (
            <div class="flex shrink-0 items-center">
              {perks.map((t) => <span class="flex items-center whitespace-nowrap">{t}<span class="mx-5 size-1.5 rounded-full bg-red"></span></span>)}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Menu -->
    <section id="menu" class="font-jakarta mx-auto max-w-[1184px] px-5 py-16 lg:px-0 lg:py-24" aria-labelledby="menu-title">
      <div data-reveal class="max-w-[576px]">
        <h2 id="menu-title" class="text-[28px] font-bold leading-tight text-ink-2 lg:text-[32px]">Daftar Menu &amp; Harga Mbak Rina</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">Tersedia pilihan potongan satuan siap santap, lauk ekoran utuh kenduri, hingga paket mika &amp; besek syukuran.</p>
      </div>

      <ul id="menu-list" class="mt-8 grid gap-3 lg:mt-10 lg:grid-cols-3 lg:gap-6">
        {firstMenu.map((m) => <MenuCard item={m} />)}
        {restMenu.map((m) => <MenuCard item={m} more />)}
        <li class="lg:hidden">
          <button type="button" id="menu-more" aria-expanded="false" aria-controls="menu-list" class="flex w-full items-center justify-center gap-2 rounded-full py-3 text-sm font-bold text-red">
            <span data-label>Lihat menu lain</span><Icon name="down" class="size-4 transition-transform duration-300" />
          </button>
        </li>
        <li data-reveal class="flex flex-col justify-between gap-6 rounded-2xl bg-white p-6">
          <div>
            <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-red"><Icon name="restaurant" class="size-3.5" />Tambahan Favorit</p>
            <h3 class="mt-2 text-lg font-bold text-ink-2">Menu Tambahan &amp; Pelengkap</h3>
            <ul class="mt-4 flex flex-col gap-2.5">
              {addons.map((a) => (
                <li class="flex items-center justify-between gap-3 rounded-xl bg-stone-2 px-4 py-3">
                  <span>
                    <span class="block text-sm font-bold text-ink-2">{a.name}</span>
                    <span class="block text-[11px] font-bold text-body">{a.note}</span>
                  </span>
                  <span class="shrink-0 text-lg font-bold text-red">{a.price} <span class="text-xs font-normal text-muted">{a.unit}</span></span>
                </li>
              ))}
            </ul>
          </div>
          <p class="rounded-xl bg-[#FFDAD6] px-4 py-3 text-[11px] font-bold italic text-[#930010]">*Harga dapat disesuaikan untuk kebutuhan pemesanan dalam porsi besar / catering acara khusus.</p>
        </li>
      </ul>

      <div data-reveal class="mt-8 flex flex-col gap-4 rounded-2xl bg-stone p-5 lg:flex-row lg:items-center lg:justify-between lg:px-6 lg:py-4">
        <div class="flex gap-3">
          <Icon name="info" class="mt-0.5 hidden size-5 shrink-0 text-red lg:block" />
          <div>
            <p class="text-sm font-bold text-ink-2">Punya Kebutuhan Khusus / Budget Acara Tertentu?</p>
            <p class="text-sm text-body">Mbak Rina siap menyesuaikan isi lauk, box packaging, serta waktu pengiriman sesuai jadwal Anda.</p>
          </div>
        </div>
        <button type="button" data-press data-order class="flex shrink-0 items-center justify-center gap-2 rounded-full bg-red px-6 py-3 text-sm font-semibold text-white hover:bg-red-dark">
          Konsultasi Menu Gratis<Icon name="forward" class="size-4" />
        </button>
      </div>
    </section>

    <!-- Nasi Box -->
    <section id="nasi-box" class="bg-red text-white" aria-labelledby="nasibox-title">
      <div class="mx-auto grid max-w-[1200px] gap-8 px-5 py-14 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-0 lg:py-24">
        <div data-reveal class="grid grid-cols-2 gap-4">
          <Image src={nasiboxBesek} alt="Nasi besek dengan ayam kremesan laos dan timun" widths={[300, 560]} sizes="(min-width: 1024px) 276px, 45vw" class="h-60 w-full rounded-3xl object-cover lg:h-[420px]" />
          <Image src={nasiboxMika} alt="Nasi box mika berisi ayam, lalapan, dan sambal" widths={[300, 560]} sizes="(min-width: 1024px) 276px, 45vw" class="h-60 w-full rounded-3xl object-cover lg:h-[420px]" />
        </div>
        <div data-reveal class="flex flex-col items-start gap-5">
          <p class="text-sm font-bold uppercase tracking-[0.12em] text-[#FFE3E8]">Untuk Acara &amp; Hajatan</p>
          <h2 id="nasibox-title" class="font-display text-3xl font-bold leading-tight lg:text-[40px]">Nasi box &amp; ayam utuh untuk syukuran, arisan, sampai acara kantor.</h2>
          <p class="text-base leading-relaxed text-[#FFE3E8] lg:text-lg">Nasi box mulai Rp30.000 lengkap lalapan &amp; sambal. Ayam utuh Rp75.000–80.000, bebek utuh Rp100.000 per ekor. Isi bisa disesuaikan budget. Pesan sehari sebelumnya.</p>
          <button type="button" data-press data-order="1 paket nasi box (sebutkan jumlah box & tanggal acara)" class="rounded-2xl bg-yellow px-6 py-4 text-[17px] font-bold text-[#2A1A12] hover:bg-[#FFD65C]">Tanya paket nasi box via WA</button>
        </div>
      </div>
    </section>

    <!-- Mengapa -->
    <section class="font-jakarta mx-auto max-w-[1184px] px-5 py-16 lg:px-0 lg:py-24" aria-labelledby="why-title">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div data-reveal class="max-w-[580px]">
          <h2 id="why-title" class="text-[28px] font-bold leading-tight text-ink-2 lg:text-[32px]">Mengapa Ayam &amp; Bebek Mbak Rina Selalu Jadi Pilihan Favorit?</h2>
          <p class="mt-3 text-base leading-relaxed text-body">Setiap pagi kami ungkep ayam &amp; bebek dengan rempah segar dari pasar. Tanpa bumbu instan.</p>
        </div>
        <dl class="grid grid-cols-3 gap-2.5 lg:w-[580px] lg:gap-4">
          {stats.map((s) => (
            <div data-reveal class={`flex items-center justify-center gap-1 rounded-2xl bg-white px-2 py-5 text-center ${s.valueFirst ? 'flex-col-reverse' : 'flex-col'}`}>
              <dt class="text-xs font-semibold text-ink-2">{s.label}</dt>
              <dd class={`text-2xl font-extrabold lg:text-5xl ${s.color}`}>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:items-start lg:gap-5">
        {reasons.map((r) => (
          <li data-reveal class="rounded-2xl bg-white p-6 transition-transform duration-300 lg:hover:-translate-y-1">
            <span class={`grid size-12 place-items-center rounded-xl ${r.bg}`}><Icon name={r.icon} class="size-6" /></span>
            <h3 class="mt-4 text-lg font-semibold text-ink-2">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{r.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Lokasi -->
    <section id="lokasi" class="font-jakarta mx-auto max-w-[1184px] px-5 pb-20 lg:px-0 lg:pb-28" aria-labelledby="lokasi-title">
      <h2 data-reveal id="lokasi-title" class="text-[28px] font-bold leading-tight text-ink-2 lg:text-center lg:text-[32px]">Mampir ke lapak kami, atau chat dulu via WhatsApp</h2>
      <div class="mt-8 grid gap-5 lg:mt-12 lg:grid-cols-2 lg:gap-6">
        {branches.map((b) => (
          <article data-reveal class="flex flex-col gap-6 rounded-3xl bg-white p-5 lg:p-10">
            <div class="grid h-44 place-items-center rounded-2xl bg-stone-2 text-sm font-medium text-muted lg:h-[260px]">[Foto toko {b.name.replace('Pasar ', '')} menyusul]</div>
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-green-soft px-3 py-1 text-[11px] font-bold text-green-dark">Buka setiap hari</span>
                <span class="text-[11px] font-bold text-body">{b.label}</span>
              </div>
              <h3 class="mt-3 text-2xl font-bold text-ink-2">{b.name}</h3>
              <div class="mt-4 flex flex-col gap-4 rounded-2xl bg-cream p-4">
                <p class="flex gap-2.5"><Icon name="place" class="mt-0.5 size-[18px] shrink-0 text-red" /><span><span class="block text-xs font-semibold text-ink-2">Alamat lapak:</span><span class="text-sm text-body">{b.address}</span></span></p>
                <p class="flex gap-2.5"><Icon name="schedule" class="mt-0.5 size-[18px] shrink-0 text-gold" /><span><span class="block text-xs font-semibold text-ink-2">Jam buka:</span><span class="text-sm text-body">{b.hours}</span></span></p>
              </div>
            </div>
            <button type="button" data-press data-order data-branch={b.name} class="mt-auto flex items-center gap-2.5 rounded-full bg-green px-6 py-4 text-sm font-bold text-white hover:bg-green-dark">
              <Icon name="chat" class="size-[18px]" /><span class="flex-1 text-left">Chat WA {b.name}</span><Icon name="forward" class="size-4" />
            </button>
          </article>
        ))}
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-red text-white">
    <div class="mx-auto max-w-[1200px] px-5 py-10 lg:px-0 lg:py-14">
      <div class="flex flex-col gap-7 lg:flex-row lg:justify-between">
        <div class="flex items-center gap-4 lg:max-w-[360px] lg:flex-col lg:items-start">
          <Image src={logo} alt="" width={120} height={106} densities={[1, 2, 3]} class="h-16 w-auto lg:h-[106px]" />
          <p class="text-sm leading-relaxed">
            <span class="lg:hidden">Ayam &amp; bebek khas Semarang, disajikan fresh tiap hari sejak {FOUNDED}.</span>
            <span class="hidden lg:inline">Ayam &amp; bebek bumbu kuning, rempah laos, dan bumbu Klaten khas Semarang. Dimasak tiap pagi di dua lapak pasar sejak {FOUNDED}.</span>
          </p>
        </div>
        <div class="lg:w-[216px]">
          <h2 class="text-[13px] font-bold uppercase tracking-wide text-yellow">Cabang</h2>
          <ul class="mt-3 grid grid-cols-2 gap-3 text-[13px] lg:grid-cols-1 lg:text-sm">
            {branches.map((b) => <li>{b.name} no. {b.street.match(/No\. (\d+)/)?.[1]}<br />Buka {b.hours}</li>)}
          </ul>
        </div>
        <div class="hidden lg:block lg:w-[216px]">
          <h2 class="text-[13px] font-bold uppercase tracking-wide text-yellow">Jelajahi</h2>
          <ul class="mt-3 flex flex-col gap-2.5 text-sm font-medium">
            <li><a href="#menu" class="hover:underline">Menu &amp; Harga</a></li>
            <li><a href="#nasi-box" class="hover:underline">Nasi Box &amp; Hajatan</a></li>
            <li><a href="#lokasi" class="hover:underline">Lokasi Cabang</a></li>
          </ul>
        </div>
        <div class="lg:w-[216px]">
