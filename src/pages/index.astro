  <OrderDialog />

  <script>
    // Reveal-on-scroll. Elements stay visible if JS or IntersectionObserver is missing.
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => {
        const sibs = [...(el.parentElement?.children ?? [])].filter((c) => c.hasAttribute('data-reveal'));
        el.style.setProperty('--d', `${Math.min(sibs.indexOf(el), 5) * 80}ms`);
        el.classList.add('reveal');
      });
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      targets.forEach((el) => io.observe(el));
    }

    // Mobile: extra menu items stay collapsed until "Lihat menu lain" is tapped.
    const moreBtn = document.getElementById('menu-more');
    const menuList = document.getElementById('menu-list');
    moreBtn?.addEventListener('click', () => {
      menuList!.classList.add('expanded');
      moreBtn.setAttribute('aria-expanded', 'true');
      moreBtn.parentElement!.hidden = true;
    });

    const open = (id: string) => (document.getElementById(id) as HTMLDialogElement | null)?.showModal();

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const opener = t.closest<HTMLElement>('[data-open]');
      if (opener) open(opener.dataset.open!);

      const closer = t.closest<HTMLElement>('[data-close]');
      if (closer) closer.closest('dialog')?.close();

      // Click on the dark backdrop closes the dialog.
      if (t instanceof HTMLDialogElement && t.open) {
        const r = t.getBoundingClientRect();
        const ev = e as MouseEvent;
        if (ev.clientX < r.left || ev.clientX > r.right || ev.clientY < r.top || ev.clientY > r.bottom) t.close();
      }
    });
  </script>
