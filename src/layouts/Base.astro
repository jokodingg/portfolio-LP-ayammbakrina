---
import '../styles/global.css';
import { SITE_URL, PHONE_E164, FOUNDED, branches, menu, waLink } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = `${SITE_URL}/og.jpg`;

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: 'Ayam Mbak Rina',
      url: SITE_URL,
      logo: `${SITE_URL}/icon-512.png`,
      telephone: PHONE_E164,
      foundingDate: FOUNDED,
      sameAs: [waLink()],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'Ayam Mbak Rina',
      inLanguage: 'id-ID',
      publisher: { '@id': `${SITE_URL}/#org` },
    },
    ...branches.map((b) => ({
      '@type': 'Restaurant',
      '@id': `${SITE_URL}/#${b.id}`,
      name: `Ayam Mbak Rina – ${b.name}`,
      parentOrganization: { '@id': `${SITE_URL}/#org` },
      url: `${SITE_URL}/#lokasi`,
      image: ogImage,
      telephone: PHONE_E164,
      priceRange: 'Rp 5.000 – Rp 100.000',
      servesCuisine: ['Indonesia', 'Jawa', 'Semarang'],
      acceptsReservations: true,
      address: {
        '@type': 'PostalAddress',
        streetAddress: b.street,
        addressLocality: 'Kota Semarang',
        addressRegion: 'Jawa Tengah',
        addressCountry: 'ID',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: days,
        opens: b.opens,
        closes: b.closes,
      },
      hasMenu: { '@id': `${SITE_URL}/#menu` },
    })),
    {
      '@type': 'Menu',
      '@id': `${SITE_URL}/#menu`,
      name: 'Daftar Menu & Harga Mbak Rina',
      inLanguage: 'id-ID',
      hasMenuItem: menu.map((m) => ({
        '@type': 'MenuItem',
        name: m.name,
        description: m.description,
        offers: { '@type': 'Offer', price: m.priceNumber, priceCurrency: 'IDR' },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#C8102E" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Ayam Mbak Rina" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paket nasi besek ayam kremesan laos Mbak Rina" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
