---
import Icon from './Icon.astro';
import { WA_NUMBER } from '../data/site';
---

<dialog id="order-dialog" class="m-0 mt-auto w-full max-w-none rounded-t-3xl bg-white p-0 text-ink shadow-[0_30px_80px_-20px_rgba(30,20,16,0.35)] lg:m-auto lg:max-w-[1184px] lg:rounded-3xl" aria-labelledby="order-title">
  <div class="font-jakarta relative grid gap-6 p-5 pt-6 lg:grid-cols-[446px_1fr] lg:items-center lg:gap-10 lg:p-10">
    <button type="button" data-close class="absolute right-4 top-4 grid size-10 place-items-center rounded-full bg-stone-2 hover:bg-stone" aria-label="Tutup form pesanan"><Icon name="close" class="size-5" /></button>

    <div class="pr-12 lg:pr-0">
      <p class="text-xs font-bold uppercase tracking-wide text-red">Format Cepat Pesanan</p>
      <h2 id="order-title" tabindex="-1" autofocus class="mt-1 text-2xl font-bold text-ink-2 outline-none">Rencanakan Pesanan Anda Sekarang</h2>
      <p class="mt-1 text-sm leading-relaxed text-body">Tuliskan detail pesanan Anda di bawah ini, lalu kirim format chat yang siap diproses oleh kasir Mbak Rina.</p>
    </div>

    <form id="order-form" class="flex flex-col gap-3 rounded-2xl bg-white lg:mr-6 lg:mt-6 lg:p-4 lg:shadow-[0_1px_3px_rgba(30,20,16,0.06)]" novalidate>
      <input type="hidden" name="branch" value="" />
      <div class="grid gap-3 sm:grid-cols-2 sm:gap-2">
        <label class="flex flex-col gap-1">
          <span class="text-[11px] font-bold text-ink-2">Nama Pemesan</span>
          <input name="name" required autocomplete="name" placeholder="Contoh: Ibu Rini" class="field" aria-describedby="err-name" />
          <span id="err-name" class="hidden text-xs font-semibold text-red">Nama pemesan wajib diisi.</span>
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] font-bold text-ink-2">Pilihan Sambal</span>
          <select name="sambal" class="field">
            <option>Sambal Bawang Pedas Nampol</option>
            <option>Sambal Terasi</option>
            <option>Tanpa sambal</option>
          </select>
        </label>
      </div>
      <label class="flex flex-col gap-1">
        <span class="text-[11px] font-bold text-ink-2">Menu yang Dipesan &amp; Jumlah</span>
        <textarea name="items" required rows="2" placeholder="Contoh: 2 Ayam Rempah Laos, 1 Bebek Bumbu Kuning, sambal dipisah ya mbak" class="field resize-none" aria-describedby="err-items"></textarea>
        <span id="err-items" class="hidden text-xs font-semibold text-red">Tulis menu dan jumlahnya dulu.</span>
      </label>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <button type="submit" data-press class="flex items-center justify-center gap-2 rounded-full bg-red px-6 py-2.5 text-xs font-semibold text-white hover:bg-red-dark sm:w-[200px]">
          <Icon name="send" class="size-3.5" />Kirim ke WhatsApp
        </button>
        <a href={`https://wa.me/${WA_NUMBER}`} target="_blank" rel="noopener" class="text-center text-[13px] font-semibold text-red underline underline-offset-4">Lewati, saya ingin chat langsung</a>
      </div>
      <p id="order-status" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-semibold"></p>
    </form>
  </div>
</dialog>

<style>
  .field {
    border-radius: 8px;
    background: var(--color-stone-2);
    padding: 7px 10px;
    font-size: 14px;
    color: var(--color-ink-2);
    border: 1.5px solid transparent;
  }
  .field::placeholder { color: var(--color-muted); }
  .field[aria-invalid='true'] { border-color: var(--color-red); background: #FFF5F5; }
</style>

<script>
  import { WA_NUMBER } from '../data/site';

  const dialog = document.getElementById('order-dialog') as HTMLDialogElement;
  const form = document.getElementById('order-form') as HTMLFormElement;
  const status = document.getElementById('order-status') as HTMLParagraphElement;
  const items = form.elements.namedItem('items') as HTMLTextAreaElement;
  const branch = form.elements.namedItem('branch') as HTMLInputElement;

  function setStatus(kind: 'ok' | 'fail' | null, html = '') {
    status.className = kind
      ? `rounded-xl px-4 py-3 text-sm font-semibold ${kind === 'ok' ? 'bg-green-soft text-green-dark' : 'bg-[#FFDAD6] text-[#930010]'}`
      : 'hidden';
    status.innerHTML = html;
  }

  // Any [data-order] button opens the form; its value pre-fills the menu field.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-order]');
    if (!btn) return;
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
    const preset = btn.dataset.order;
    if (preset && !items.value.includes(preset)) items.value = items.value ? `${items.value}, ${preset}` : preset;
    branch.value = btn.dataset.branch ?? '';
    setStatus(null);
    dialog.showModal();
  });

  form.addEventListener('input', (e) => {
    const f = e.target as HTMLInputElement;
    if (f.getAttribute('aria-invalid') === 'true' && f.value.trim()) {
      f.removeAttribute('aria-invalid');
      document.getElementById(f.getAttribute('aria-describedby')!)?.classList.add('hidden');
    }
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let firstBad: HTMLInputElement | null = null;
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((f) => {
      const bad = !f.value.trim();
      if (bad) f.setAttribute('aria-invalid', 'true');
      else f.removeAttribute('aria-invalid');
      document.getElementById(f.getAttribute('aria-describedby')!)?.classList.toggle('hidden', !bad);
      if (bad && !firstBad) firstBad = f;
    });
    if (firstBad) {
      (firstBad as HTMLInputElement).focus();
      return;
    }

    const d = new FormData(form);
    const text = [
      'Halo Mbak Rina, saya mau pesan:',
      '',
      `Nama: ${d.get('name')}`,
      `Pesanan: ${d.get('items')}`,
      `Sambal: ${d.get('sambal')}`,
      ...(d.get('branch') ? [`Cabang: ${d.get('branch')}`] : []),
      '',
      'Terima kasih.',
    ].join('\n');
    const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(text)}`;
    setStatus('ok', 'Format pesanan sudah dibuka di WhatsApp. Tinggal tekan kirim di sana.');
    if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
      window.location.href = url;
      return;
    }
    const win = window.open(url, '_blank');
    if (win) win.opener = null;
    else setStatus('fail', `WhatsApp tidak terbuka otomatis. <a class="underline" href="${url}" target="_blank" rel="noopener">Buka WhatsApp di sini</a>.`);
  });
</script>
